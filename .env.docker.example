# Copy to .env before docker compose up. Generate random values; never commit this file.
POSTGRES_PASSWORD=replace-with-a-unique-database-password
SECRET_KEY=replace-with-at-least-32-random-characters
# Optional SMTP configuration for customer email confirmations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BookFlow <noreply@example.com>
# Public browser origins and API URL. Change these for your deployed domain.
CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:8000
