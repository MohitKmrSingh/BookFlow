# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

APP_NAME=BookFlow
APP_ENV=development
API_V1_PREFIX=/api

# PostgreSQL
# Example: postgresql+psycopg://USER:PASSWORD@localhost:5432/bookflow
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/bookflow

# JWT
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Notifications (optional in v1 — logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BookFlow <noreply@example.com>
